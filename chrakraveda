        <input value={q} onChange={(e) => setQ(e.target.value)} placeholder="Search components, sensors, MCUs..." className="w-full bg-slate-800 border border-slate-700 focus:border-cyan-500 outline-none rounded-lg pl-9 pr-3 py-2 text-sm" />
      </div>
      <div className="flex flex-wrap gap-2">{LV.map((l, i) => <button key={l} onClick={() => setLv(i)} className={pill(lv === i)}>{l}</button>)}</div>
      <div className="flex flex-wrap gap-2">{["All", ...Object.keys(CATS)].map((c) => <button key={c} onClick={() => setCat(c)} className={pill(cat === c)}>{c}</button>)}</div>
      <p className="text-xs text-slate-400">{list.length} of {LIB.length} components</p>
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {list.map((e) => (
          <button key={e.n} onClick={() => open(e)} className="text-left bg-slate-800 border border-slate-700 hover:border-cyan-500 hover:scale-105 rounded-xl p-4 transition-all active:scale-95 cursor-pointer">
            <span className="flex items-start justify-between gap-2"><span className="font-semibold">{e.n}</span><span className={"text-xs border rounded-full px-2 py-0.5 shrink-0 " + LVC[e.l]}>{LV[e.l]}</span></span>
            <span className="block text-xs text-cyan-400 mt-0.5">{e.c}</span>
            <span className="block text-sm text-slate-300 mt-2">{e.d}</span>
            {SIM[e.n] && <span className="block text-xs text-violet-300 mt-2">Live simulator inside</span>}
          </button>
        ))}
      </div>
      {!list.length && <Card c="text-center text-sm text-slate-400">No match. Try a different search or clear a filter.</Card>}
      {sel && (
        <div className="fixed inset-0 z-50 flex justify-end" style={{ background: "rgba(2,6,23,.7)" }} onClick={() => setSel(null)}>
          <aside onClick={(e) => e.stopPropagation()} className="w-full sm:w-96 h-full bg-slate-800 border-l border-slate-700 p-6 overflow-y-auto">
            <div className="flex justify-between items-start">
              <h3 className="text-xl font-bold">{sel.n}</h3>
              <button onClick={() => setSel(null)} aria-label="Close" className="p-1 text-slate-400 hover:text-white active:scale-95 cursor-pointer"><X className="w-5 h-5" /></button>
            </div>
            <p className="flex items-center gap-2 mt-2 text-xs"><span className="text-cyan-400">{sel.c}</span><span className={"border rounded-full px-2 py-0.5 " + LVC[sel.l]}>{LV[sel.l]}</span></p>
            <h4 className="font-semibold mt-5 mb-1">What it is</h4>
            <p className="text-sm text-slate-300">{sel.d}</p>
            <h4 className="font-semibold mt-5 mb-1">Typical use</h4>
            <p className="text-sm text-slate-300">{sel.u}</p>
            {S && (
              <div className="mt-5 p-3 bg-slate-900 border border-slate-700 rounded-lg">
                <h4 className="flex items-center gap-2 font-semibold mb-3"><Activity className="w-4 h-4 text-violet-400" />Live simulator</h4>
                <Slider l={S[0] + " (" + S[1] + ")"} v={x} set={setX} min={S[2]} max={S[3]} step={S[5] || 1} />
                <p className="font-mono text-sm text-cyan-300 mt-3">{S[4](x)}</p>
              </div>
            )}
          </aside>
        </div>
      )}
    </div>
  );
}

/* ============================== APP ============================== */
export default function App() {
  const [tab, setTab] = useState("dash"), [labSub, setLabSub] = useState("gate"), [queries, setQueries] = useState(34), [wins, setWins] = useState(9);
  const [p, setP] = useState({ l: 4, x: 450, m: 600 });
  const addXp = (n) => setP(({ l, x, m }) => { x += n; while (x >= m) { x -= m; l++; m += 200; } return { l, x, m }; });
  const launch = (n) => { setTab(n.tab); if (n.lab) setLabSub(n.lab); };
  const pane = (k, el) => <div className={tab === k ? "" : "hidden"}>{el}</div>;
  const nav = (mobile) => TABS.map(([k, l, Ic]) => (
    <button key={k} onClick={() => setTab(k)} className={"flex items-center gap-2 rounded-lg text-sm font-semibold transition-all active:scale-95 cursor-pointer shrink-0 " + (mobile ? "px-3 py-2 " : "px-3 py-2.5 w-full ") + (tab === k ? "bg-cyan-500 text-slate-900" : "text-slate-300 bg-slate-800 hover:bg-slate-700")}>
      <Ic className="w-4 h-4" />{l}
    </button>
  ));
  return (
    <div className="min-h-screen bg-slate-900 text-slate-100 md:flex">
      <aside className="hidden md:flex flex-col gap-2 w-60 shrink-0 h-screen sticky top-0 p-4 border-r border-slate-700 backdrop-blur-md" style={GLASS}>
        <div className="flex items-center gap-2 mb-4"><Cpu className="w-6 h-6 text-cyan-400" /><div><p className="font-bold leading-tight">ChakraVeda</p><p className="text-xs text-slate-400">Smart ENTC Learning</p></div></div>
        {nav(false)}
      </aside>
      <div className="flex-1 min-w-0">
        <header className="sticky top-0 z-40 px-4 py-3 border-b border-slate-700 backdrop-blur-md" style={GLASS}>
          <p className="flex items-center gap-2 text-sm font-semibold"><Zap className="w-4 h-4 text-violet-400" />Rank: Quantum Innovator | Level {p.l} ({p.x}/{p.m} XP)</p>
          <div className="h-2 mt-2 bg-slate-700 rounded-full overflow-hidden"><div className="h-full bg-emerald-500 transition-all duration-500" style={{ width: (p.x / p.m) * 100 + "%" }} /></div>
          <nav className="md:hidden flex gap-2 mt-3 overflow-x-auto pb-1">{nav(true)}</nav>
        </header>
        <main className="p-4 md:p-6 max-w-6xl mx-auto">
          <h1 className="text-2xl md:text-3xl font-bold">ChakraVeda</h1>
          <p className="text-slate-400 text-sm mb-6">Smart ENTC Learning & Innovation Platform</p>
          {pane("dash", <Dashboard queries={queries} wins={wins} launch={launch} />)}
          {pane("lab", <Lab sub={labSub} setSub={setLabSub} active={tab === "lab"} />)}
          {pane("ai", <Copilot onQuery={() => setQueries((q) => q + 1)} />)}
          {pane("code", <Playground onWin={() => { setWins((w) => w + 1); addXp(50); }} />)}
          {pane("trivia", <Trivia active={tab === "trivia"} onXp={addXp} />)}
          {pane("lib", <ComponentLibrary />)}
        </main>
      </div>
    </div>
  );
}
