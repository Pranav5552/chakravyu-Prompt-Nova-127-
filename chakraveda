<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ChakraVeda — ENTC Learning Platform</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #090909;
      --panel: #111112;
      --panel-2: #171718;
      --border: #303033;
      --text: #f4f4f5;
      --muted: #a1a1aa;
      --red: #dc2626;
      --red-light: #f87171;
      --green: #34d399;
      --amber: #fbbf24;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-width: 320px;
      background: var(--bg);
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    button, input, select, textarea { font: inherit; }
    button { cursor: pointer; }
    button:active { transform: scale(.98); }
    a { color: inherit; }
    .hidden { display: none !important; }

    .login-page {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 24px;
      background: radial-gradient(ellipse at 20% 10%, #351010 0, transparent 45%), var(--bg);
    }
    .login-card {
      width: min(960px, 100%);
      min-height: 560px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 24px;
      background: #0e0e0f;
    }
    .login-hero {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 42px;
      background: linear-gradient(145deg, #3b1010, #160a0a 58%, #090909);
    }
    .login-form { display: flex; flex-direction: column; justify-content: center; padding: 42px; }
    .brand { display: flex; align-items: center; gap: 11px; font-size: 20px; font-weight: 900; }
    .brand-mark {
      display: grid;
      width: 40px;
      height: 40px;
      place-items: center;
      border-radius: 12px;
      background: var(--red);
      font-size: 22px;
    }
    .brand span:last-child span { color: var(--red-light); }
    h1, h2, h3, p { margin-top: 0; }
    .login-hero h1 { max-width: 440px; font-size: clamp(36px, 5vw, 56px); line-height: 1.07; }
    .login-hero p { max-width: 430px; color: #c4c4c8; line-height: 1.7; }
    .eyebrow { color: var(--red-light); font-size: 12px; font-weight: 800; letter-spacing: .18em; }
    .muted { color: var(--muted); }
    .small { font-size: 12px; }
    label { display: block; margin: 14px 0 7px; color: #d4d4d8; font-size: 13px; }
    input, select, textarea {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 11px;
      background: #080808;
      color: var(--text);
      outline: none;
    }
    input, select { padding: 12px 14px; }
    textarea { padding: 14px; resize: vertical; }
    input:focus, select:focus, textarea:focus { border-color: var(--red); }
    .button {
      border: 1px solid var(--border);
      border-radius: 11px;
      padding: 11px 15px;
      background: var(--panel-2);
      color: var(--text);
      transition: .18s ease;
    }
    .button:hover { border-color: var(--red); transform: translateY(-1px); }
    .button-red { border-color: var(--red); background: var(--red); font-weight: 700; }
    .button-red:hover { background: #ef4444; }
    .button-green { border-color: #065f46; background: #052e24; color: #a7f3d0; }
    .button-small { padding: 8px 11px; font-size: 13px; }
    .error { min-height: 20px; margin-top: 8px; color: #f87171; font-size: 13px; }

    .topbar {
      position: sticky;
      z-index: 20;
      top: 0;
      display: flex;
      min-height: 66px;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 10px 22px;
      border-bottom: 1px solid var(--border);
      background: rgb(0 0 0 / 88%);
      backdrop-filter: blur(14px);
    }
    .rank { width: min(390px, 38vw); }
    .rank-line { display: flex; justify-content: space-between; gap: 12px; font-size: 12px; }
    .rank-line strong { color: #fecaca; }
    .progress { height: 6px; margin-top: 7px; overflow: hidden; border-radius: 99px; background: #29292b; }
    .progress > div { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #991b1b, #f87171); transition: width .3s; }
    .shell { display: flex; max-width: 1600px; min-height: calc(100vh - 66px); margin: auto; }
    .sidebar {
      position: sticky;
      top: 66px;
      width: 235px;
      height: calc(100vh - 66px);
      flex: 0 0 235px;
      padding: 20px 14px;
      border-right: 1px solid var(--border);
      background: #0b0b0b;
    }
    .side-label { margin: 5px 10px 12px; color: #71717a; font-size: 11px; letter-spacing: .16em; }
    .nav-button {
      display: flex;
      width: 100%;
      align-items: center;
      gap: 12px;
      margin: 4px 0;
      border: 0;
      border-radius: 11px;
      padding: 12px;
      background: transparent;
      color: #a1a1aa;
      text-align: left;
      transition: .18s;
    }
    .nav-button:hover { background: #191919; color: white; }
    .nav-button.active { background: #3b1111; color: #fecaca; }
    main { min-width: 0; flex: 1; padding: 28px clamp(16px, 3vw, 40px); }
    .content { max-width: 1240px; margin: auto; }
    .page { animation: open .22s ease-out; }
    @keyframes open { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    .page-heading { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 22px; }
    .page-heading h1 { margin: 5px 0; font-size: clamp(27px, 4vw, 36px); }
    .page-heading p { margin: 6px 0 0; color: var(--muted); }
    .grid { display: grid; gap: 16px; }
    .grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .card {
      border: 1px solid var(--border);
      border-radius: 17px;
      padding: 19px;
      background: rgb(18 18 19 / 90%);
    }
    .metric { transition: .2s ease; }
    .metric:hover { transform: translateY(-4px); border-color: #7f1d1d; }
    .metric-label { display: flex; align-items: center; justify-content: space-between; color: var(--muted); font-size: 13px; }
    .metric-value { margin: 15px 0 0; font-size: 32px; font-weight: 800; }
    .roadmap-node {
      width: 100%;
      border: 1px solid #303033;
      border-radius: 13px;
      padding: 15px;
      background: #090909;
      color: var(--text);
      text-align: left;
      transition: .18s;
    }
    .roadmap-node:hover { border-color: #991b1b; transform: translateY(-2px); }
    .node-top { display: flex; justify-content: space-between; gap: 8px; margin-bottom: 12px; color: #71717a; font-size: 11px; }
    .status-good { color: var(--green); }
    .status-active { color: var(--amber); }
    .status-locked { color: #71717a; }
    .drawer-backdrop { position: fixed; z-index: 40; inset: 0; display: flex; justify-content: flex-end; background: #000b; }
    .drawer { width: min(430px, 100%); height: 100%; padding: 28px; border-left: 1px solid var(--border); background: #101011; box-shadow: -20px 0 60px #0009; }
    .two-col { display: grid; grid-template-columns: 310px minmax(0, 1fr); gap: 18px; }
    .component-list { max-height: 480px; overflow: auto; }
    .component-item { display: block; width: 100%; border: 0; border-radius: 8px; padding: 9px 10px; background: transparent; color: #a1a1aa; text-align: left; font-size: 13px; }
    .component-item:hover, .component-item.selected { background: #351111; color: #fecaca; }
    .sim-diagram {
      display: grid;
      min-height: 180px;
      place-items: center;
      margin: 19px 0;
      border: 1px solid var(--border);
      border-radius: 13px;
      background: radial-gradient(ellipse at center, #291111, #080808 72%);
    }
    .diagram-row { display: flex; align-items: center; gap: 0; }
    .wire { width: clamp(30px, 8vw, 105px); height: 3px; background: #71717a; }
    .component-block { border: 2px solid var(--red); border-radius: 8px; padding: 15px; background: #171717; }
    .controls { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
    input[type="range"] { padding: 0; accent-color: var(--red); }
    .log {
      min-height: 80px;
      white-space: pre-wrap;
      border-radius: 11px;
      padding: 14px;
      background: #050505;
      color: #86efac;
      font: 13px/1.7 ui-monospace, SFMono-Regular, Menlo, monospace;
    }
    .chat-box { display: flex; min-height: 480px; flex-direction: column; }
    .messages { display: flex; flex: 1; flex-direction: column; gap: 12px; overflow: auto; padding: 6px 2px 14px; }
    .message { max-width: 90%; white-space: pre-wrap; border-radius: 12px; padding: 13px; font-size: 13px; line-height: 1.7; }
    .message.bot { background: #080808; color: #d4d4d8; }
    .message.user { align-self: flex-end; background: #451313; color: #fff; }
    .chat-form { display: flex; gap: 9px; }
    .chat-form input { min-width: 0; flex: 1; }
    .quick-pills { display: grid; gap: 9px; margin-top: 15px; }
    .quick-pills button { text-align: left; line-height: 1.5; }
    .editor { min-height: 350px; color: #a7f3d0; font: 13px/1.65 ui-monospace, SFMono-Regular, Menlo, monospace; }
    .quiz-option { width: 100%; margin-top: 8px; text-align: left; }
    .quiz-option.correct { border-color: #059669; background: #052e24; color: #a7f3d0; }
    .quiz-option.wrong { border-color: #dc2626; background: #3b1111; color: #fecaca; }
    .symbol-grid, .name-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .symbol {
      display: grid;
      min-height: 84px;
      place-items: center;
      font-size: 25px;
    }
    .symbol.chosen { border-color: var(--red); background: #351111; }
    .symbol.matched, .name.matched { border-color: #047857; background: #052e24; color: #a7f3d0; }
    footer { margin-top: 38px; border-top: 1px solid #222; padding: 18px 0; color: #71717a; text-align: center; font-size: 12px; }

    @media (max-width: 980px) {
      .grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .two-col { grid-template-columns: 1fr; }
      .component-list { max-height: 260px; }
    }
    @media (max-width: 700px) {
      .login-card { grid-template-columns: 1fr; }
      .login-hero { min-height: 270px; padding: 28px; }
      .login-form { padding: 28px; }
      .topbar { padding: 10px 13px; }
      .rank { display: none; }
      .shell { display: block; }
      .sidebar {
        position: static;
        width: 100%;
        height: auto;
        padding: 8px;
        border-right: 0;
        border-bottom: 1px solid var(--border);
      }
      .side-label { display: none; }
      .nav-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; }
      .nav-button { justify-content: center; padding: 10px 4px; font-size: 11px; }
      main { padding: 20px 14px; }
      .grid-2 { grid-template-columns: 1fr; }
      .controls { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div id="root"></div>

  <script>
    const catalog = {
      "Passive Components": "Resistor|Potentiometer|Rheostat|Trimpot|Thermistor|Varistor|Light-Dependent Resistor|Ceramic Capacitor|Multilayer Ceramic Capacitor|Electrolytic Capacitor|Tantalum Capacitor|Film Capacitor|Supercapacitor|Variable Capacitor|Air Core Inductor|Iron Core Inductor|Ferrite Core Inductor|Toroidal Inductor|Choke|Step-up Transformer|Step-down Transformer|Isolation Transformer|Autotransformer|Current Transformer|Potential Transformer|Pulse Transformer",
      "Active Components": "Rectifier Diode|Zener Diode|Schottky Diode|Fast Recovery Diode|Tunnel Diode|PIN Diode|Photodiode|Laser Diode|Light Emitting Diode|Bipolar Junction Transistor|Darlington Pair|Junction Field-Effect Transistor|Metal-Oxide-Semiconductor FET|Gallium Nitride FET|Silicon Carbide MOSFET|Insulated-Gate Bipolar Transistor|Silicon Controlled Rectifier|Triac|Diac|Gate Turn-Off Thyristor|Magnetron|Klystron|Traveling Wave Tube",
      "Integrated Circuits & Packages": "Operational Amplifier|Comparator|Linear Voltage Regulator|Switching Voltage Regulator|Audio Amplifier|Phase-Locked Loop|Logic Gate|Flip-Flop|Multiplexer|Demultiplexer|Shift Register|Counter|Encoder|Decoder|Analog-to-Digital Converter|Digital-to-Analog Converter|Real-Time Clock|Battery Charger IC|Motor Driver IC|Hot-Swap Controller|RF Transceiver|Bluetooth System-on-Chip|Wi-Fi System-on-Chip|Dual In-line Package|Single In-line Package|TO-92 Transistor Package|TO-220 Transistor Package|Small Outline Integrated Circuit|Small Outline Package|Shrink Small Outline Package|Thin Shrink Small Outline Package|SOT-23 Transistor Package|SOT-223 Transistor Package|Quad Flat Package|Quad Flat No-leads|Ball Grid Array|Land Grid Array",
      "Processors & Microcontrollers": "Intel Core Processor|AMD Ryzen Processor|ARM Cortex-A Processor|Digital Signal Processor|Graphics Processing Unit|Tensor Processing Unit|Atmel AVR Microcontroller|PIC Microcontroller|8051 Microcontroller|TI MSP430 Microcontroller|STM32 Microcontroller|ESP32 Microcontroller|TI C2000 Microcontroller|NXP i.MX Microcontroller|Field Programmable Gate Array|Complex Programmable Logic Device|Motherboard Northbridge|Motherboard Southbridge|PCIe Switch|Ethernet Controller Chipset",
      "Sensors": "Type J Thermocouple|Type K Thermocouple|PT100 Resistance Temperature Detector|PT1000 Resistance Temperature Detector|Digital Temperature Sensor|Inductive Proximity Sensor|Capacitive Proximity Sensor|Magnetic Hall-Effect Sensor|Ultrasonic Sensor|Linear Variable Differential Transformer|Photoresistor Sensor|Phototransistor Sensor|Infrared Barrier Sensor|Time-of-Flight Laser Sensor|Ambient Light Sensor|Accelerometer|Gyroscope|Inertial Measurement Unit|Strain Gauge|Load Cell|Piezoelectric Force Sensor|Pressure Transducer|Turbine Flow Meter|Electromagnetic Flow Meter|Coriolis Flow Meter|Liquid Level Float Switch|Radar Level Transmitter|Ultrasonic Level Transmitter|Carbon Dioxide Gas Sensor|Methane Gas Sensor|Oxygen Gas Sensor|pH Sensor|Particulate Matter Air Quality Sensor|Machine Vision Camera|Smart Barcode Scanner|LiDAR Scanner",
      "Actuators": "Linear Solenoid|Rotary Solenoid|Magnetic Door Lock|Brushed DC Motor|Brushless DC Motor|Coreless DC Motor|Unipolar Stepper Motor|Bipolar Stepper Motor|RC Servo Motor|Industrial AC Servo Motor|Industrial DC Servo Motor|Electro-Pneumatic Cylinder|Electro-Hydraulic Valve|Piezoelectric Actuator|Shape Memory Alloy Wire",
      "Electromechanical Components": "Toggle Switch|Tactile Push-Button Switch|Slide Switch|Rocker Switch|DIP Switch|Rotary Switch|Limit Switch|Micro Switch|Reed Switch|Electromechanical Relay|Solid-State Relay|Reed Relay|Signal Relay|Time-Delay Relay|Piezoelectric Buzzer|Magnetic Buzzer|Speaker|Microphone|Extruded Heatsink|Cooling Fan|Peltier Thermoelectric Cooler",
      "Wires & Cables": "Hook-up Wire|Magnet Wire|Enamelled Copper Wire|Stranded Copper Wire|Ribbon Cable|Twisted Pair Signal Wire|Coaxial Cable|Shielded Twisted Pair Cable|Flexible Shielded Control Cable|Armoured Power Cable|Steel Wire Armoured Cable|Unarmoured PVC Cable|Unarmoured XLPE Cable|Variable Frequency Drive Cable|Profibus Cable|Profinet Cable|Modbus RS485 Cable|DeviceNet Cable|Shielded Cat6A Ethernet Cable|Shielded Cat7 Ethernet Cable|Single-mode Fiber Optic Cable|Multi-mode Fiber Optic Cable",
      "Connectors & Interconnects": "Pin Header|JST Connector|Molex Plug|Screw Terminal Block|Card Edge Connector|RJ45 Connector|USB Type-A Connector|USB Type-B Connector|USB Type-C Connector|DB9 D-Sub Connector|DB25 D-Sub Connector|HDMI Connector|DisplayPort Connector|SMA RF Connector|BNC RF Connector|TNC RF Connector|N-Type RF Connector|MCX RF Connector|U.FL RF Connector|M8 Circular Connector|M12 Circular Connector|Harting Heavy-Duty Connector|Camlock High-Current Connector|Ring Crimp Terminal|Spade Crimp Terminal|DIN-Rail Mounted Terminal Block|Wago Push-in Wire Connector",
      "Fuses & Safety": "Glass Tube Fuse|Ceramic Cartridge Fuse|Automotive Blade Fuse|Subminiature Fuse|Resettable PTC Polyfuse|Thermal Circuit Breaker|High Rupturing Capacity Fuse|Semiconductor Ultra-Fast Fuse|Thermal Fuse Cutoff|Bimetallic Thermal Switch|Miniature Circuit Breaker|Molded Case Circuit Breaker|Earth Leakage Circuit Breaker|Residual Current Circuit Breaker|Motor Protection Circuit Breaker|Thermal Overload Relay|Surge Protection Device|Lightning Arrester|Isolation Monitoring Relay|Safety Logic Relay|Emergency Stop Pushbutton|Safety Light Curtain|Magnetic Safety Interlock Switch|Key Trapped Interlock System|Safety Laser Scanner",
      "Machines & Instruments": "Variable Frequency Drive|AC Soft Starter|Digital Servo Drive|Stepper Driver|Programmable Logic Controller|Distributed Control System|Remote Terminal Unit|Human-Machine Interface|AC-DC Linear Power Supply|Switch-Mode Power Supply|Uninterruptible Power Supply|High-Voltage DC Converter|Three-phase AC Induction Motor|Synchronous Motor|Alternator|Power Distribution Switchgear|Busbar System|Digital Multimeter|Digital Storage Oscilloscope|Function Generator|Programmable DC Laboratory Power Supply|Spectrum Analyzer|LCR Meter|Logic Analyzer|Insulation Resistance Tester|Thermal Imaging Camera|Power Quality Analyzer|Earth Ground Resistance Tester"
    };

    const components = Object.entries(catalog).flatMap(([category, names]) =>
      names.split("|").map(name => ({ name, category }))
    );

    const questions = [
      {
        question: "For a band-limited signal with a maximum frequency of 4 kHz, what ideal sampling rate avoids aliasing?",
        options: ["2 kHz", "4 kHz", "More than 8 kHz", "Exactly 4 kHz"],
        answer: 2,
        explanation: "The Nyquist–Shannon theorem requires a sampling frequency greater than twice the signal's highest frequency. Real systems also need an anti-aliasing filter and practical margin."
      },
      {
        question: "Which op-amp configuration produces a 180° phase inversion?",
        options: ["Voltage follower", "Inverting amplifier", "Non-inverting amplifier", "Comparator with no feedback"],
        answer: 1,
        explanation: "An inverting amplifier has ideal gain −Rf/Rin. The negative sign indicates a 180° phase reversal between input and output."
      },
      {
        question: "A typical UART frame commonly contains which structure?",
        options: ["Start bit, data bits, optional parity, stop bit(s)", "Clock, address, data, acknowledgement only", "Only a continuous clock and data pair", "Preamble, payload, CRC, Manchester code"],
        answer: 0,
        explanation: "UART is asynchronous. A frame usually contains a start bit, data bits, optional parity, and one or more stop bits. Both devices need matching baud rate and frame settings."
      }
    ];

    let user = localStorage.getItem("cv-user") || "";
    let page = "Dashboard";
    let xp = Number(localStorage.getItem("cv-xp")) || 450;
    let selectedComponent = components[0];
    let selectedCategory = "All components";
    let selectedModule = null;
    let logicA = false, logicB = true, gate = "AND";
    let frequency = 4, noise = 8, voltage = 5, resistance = 1000;
    let messages = [{ role: "bot", text: "Hello! Ask an ENTC question or choose a quick prompt. I can help explain concepts and suggest debugging steps." }];
    let chatLoading = false;
    let code = `const int sensorPin = A0;
const int fanPin = 13;
const float thresholdC = 75.0;

void setup() {
  pinMode(fanPin, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  int raw = analogRead(sensorPin);
  float voltage = raw * (5.0 / 1023.0);
  float temperatureC = (voltage - 0.5) * 100.0;

  if (temperatureC > thresholdC) {
    digitalWrite(fanPin, HIGH);
  } else {
    digitalWrite(fanPin, LOW);
  }
  delay(250);
}`;
    let terminal = "Ready. Edit the sketch, then compile or run the local checks.";
    let compiling = false;
    let quizIndex = 0, quizAnswer = null, quizTime = 30;
    let timerId = null;
    let selectedSymbol = null;
    let matchedSymbols = [];
    const symbols = ["Resistor", "Zener diode", "NPN transistor", "Electrolytic capacitor"];
    const shuffledNames = ["Electrolytic capacitor", "Resistor", "NPN transistor", "Zener diode"];

    // Auth state
    let authMode = "login";
    let authNotice = "";
    let showChangePassword = false;

    function esc(text) {
      return String(text).replace(/[&<>"']/g, c => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
      }[c]));
    }

    function getAccounts() {
      try {
        return JSON.parse(localStorage.getItem("cv-accounts") || "{}");
      } catch {
        return {};
      }
    }

    function saveAccounts(accounts) {
      localStorage.setItem("cv-accounts", JSON.stringify(accounts));
    }

    function setAuthMode(mode) {
      authMode = mode;
      authNotice = "";
      render();
    }

    function authSubmit(event) {
      event.preventDefault();
      const email = document.getElementById("auth-email")?.value.trim().toLowerCase();
      const password = document.getElementById("auth-password")?.value;
      const confirmPassword = document.getElementById("auth-confirm")?.value;
      const accounts = getAccounts();

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        authNotice = "Enter a valid email address.";
        render();
        return;
      }

      if (authMode === "create") {
        if (password.length < 8) {
          authNotice = "Use a password with at least 8 characters.";
          render();
          return;
        }
        if (password !== confirmPassword) {
          authNotice = "The passwords do not match.";
          render();
          return;
        }
        if (accounts[email]) {
          authNotice = "An account already exists for this email. Please sign in.";
          render();
          return;
        }
        accounts[email] = { password };
        saveAccounts(accounts);
        user = email;
        localStorage.setItem("cv-user", user);
        authMode = "login";
        authNotice = "";
        render();
        return;
      }

      if (authMode === "forgot") {
        if (!accounts[email]) {
          authNotice = "No account was found for that email address.";
          render();
          return;
        }
        if (password.length < 8) {
          authNotice = "Your new password must have at least 8 characters.";
          render();
          return;
        }
        if (password !== confirmPassword) {
          authNotice = "The new passwords do not match.";
          render();
          return;
        }
        accounts[email].password = password;
        saveAccounts(accounts);
        authMode = "login";
        authNotice = "Password updated. You can now sign in.";
        render();
        return;
      }

      // login
      if (!accounts[email] || accounts[email].password !== password) {
        authNotice = "Email or password is incorrect. Create an account if you are new.";
        render();
        return;
      }
      user = email;
      localStorage.setItem("cv-user", user);
      authNotice = "";
      render();
    }

    function openChangePassword() {
      showChangePassword = true;
      render();
    }

    function closeChangePassword() {
      showChangePassword = false;
      render();
    }

    function submitChangePassword(event) {
      event.preventDefault();
      const currentPassword = document.getElementById("current-password").value;
      const newPassword = document.getElementById("new-password").value;
      const confirmPassword = document.getElementById("confirm-new-password").value;
      const accounts = getAccounts();
      const account = accounts[user.toLowerCase()];
      const error = document.getElementById("change-password-error");

      if (!account || account.password !== currentPassword) {
        error.textContent = "Your current password is incorrect.";
        return;
      }
      if (newPassword.length < 8) {
        error.textContent = "Your new password must have at least 8 characters.";
        return;
      }
      if (newPassword !== confirmPassword) {
        error.textContent = "The new passwords do not match.";
        return;
      }
      account.password = newPassword;
      saveAccounts(accounts);
      showChangePassword = false;
      authNotice = "";
      render();
      alert("Your password has been changed.");
    }

    function changePasswordModal() {
      if (!showChangePassword) return "";
      return `
        <div class="drawer-backdrop" onclick="if(event.target===this) closeChangePassword()">
