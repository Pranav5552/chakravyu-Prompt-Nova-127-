        if (!code.trim()) {
          terminal = "[ERROR] Compilation failed: empty sketch.\\n[ERROR] No setup() or loop() function found.\\n[FAILURE] Build aborted.";
        } else if (compile) {
          terminal = "[INFO] Initializing Compiler...\\n[SUCCESS] Sketch compiled cleanly. 14,240 bytes written to partition.";
        } else {
          terminal = [
            `[${code.includes("analogRead") ? "PASS" : "FAIL"}] Analog sensor read`,
            `[${code.includes("temperatureC > 75") || code.includes("temperatureC > thresholdC") ? "PASS" : "FAIL"}] 75°C threshold condition`,
