          </article>
          <article class="card">
            <h2>Component identification matrix</h2><p class="small muted">Select a schematic symbol, then its matching name.</p>
            <div class="symbol-grid" style="margin-top:14px">${symbolButtons}</div>
            <div class="name-grid" style="margin-top:12px">${nameButtons}</div>
            <p id="pair-notice" class="small muted" style="margin:14px 0 0">${selectedSymbol===null?"":"Selected symbol. Choose its name."}</p>
          </article>
        </div>
      </section>`;
    }

    function answerQuiz(index) {
      if (quizAnswer !== null || quizTime === 0) return;
      quizAnswer = index;
      if (index === questions[quizIndex].answer) awardXP(25);
      render();
    }

    function nextQuestion() {
      quizIndex = (quizIndex + 1) % questions.length;
      quizAnswer = null;
      quizTime = 30;
      render();
    }

    function pickSymbol(index) {
      selectedSymbol = index;
      render();
    }

    function pairSymbol(name) {
      if (selectedSymbol === null) {
        alert("Choose a schematic symbol first.");
        return;
      }
      if (symbols[selectedSymbol] === name) {
        if (!matchedSymbols.includes(name)) {
          matchedSymbols.push(name);
          awardXP(10);
        }
      } else {
        alert("Not quite—check the symbol terminals and try again.");
      }
      selectedSymbol = null;
      render();
    }

    function render() {
      const root = document.getElementById("root");

      if (!user) {
        const isCreate = authMode === "create";
        const isForgot = authMode === "forgot";
        const title = isCreate
          ? "Create your account"
          : isForgot
            ? "Reset your password"
            : "Sign in to ChakraVeda";
        const description = isForgot
          ? "Enter your account email and choose a new password."
          : isCreate
            ? "Create an account to save your learning progress in this browser."
            : "Sign in with your account email and password.";

        root.innerHTML = `
          <div class="login-page">
            <div class="login-card">
              <section class="login-hero">
                <div class="brand">
                  <div class="brand-mark">ϟ</div>
                  <div>Chakra<span style="color:#f87171">Veda</span></div>
                </div>
                <div>
                  <div class="eyebrow">LEARN · BUILD · INNOVATE</div>
                  <h1>Your electronics lab, reimagined.</h1>
                  <p>Explore components, test circuits, write embedded code, and grow your engineering skills.</p>
                </div>
                <span class="small muted">ChakraVeda · ENTC learning platform</span>
              </section>
              <form class="login-form" onsubmit="authSubmit(event)">
                <div class="eyebrow">${isCreate ? "GET STARTED" : isForgot ? "ACCOUNT RECOVERY" : "WELCOME BACK"}</div>
                <h2 style="font-size:30px;margin:8px 0">${title}</h2>
                <p class="muted small" style="line-height:1.6">${description}</p>
                <label for="auth-email">Gmail / email</label>
                <input id="auth-email" type="email" placeholder="engineer@gmail.com" required>
                <label for="auth-password">${isForgot ? "New password" : "Password"}</label>
                <input id="auth-password" type="password" placeholder="At least 8 characters" minlength="8" required>
                ${authMode !== "login" ? `
                  <label for="auth-confirm">Confirm password</label>
                  <input id="auth-confirm" type="password" placeholder="Enter the password again" minlength="8" required>
                ` : ""}
                <div class="error" role="alert">${esc(authNotice)}</div>
                <button class="button button-red" style="margin-top:8px;width:100%">
                  ${isCreate ? "Create account" : isForgot ? "Reset password" : "Sign in"}
                </button>
                <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin-top:17px">
                  ${authMode !== "login" ? `
                    <button type="button" class="button button-small" onclick="setAuthMode('login')">Back to sign in</button>
                  ` : `
                    <button type="button" class="button button-small" onclick="setAuthMode('create')">Create account</button>
                    <button type="button" class="button button-small" onclick="setAuthMode('forgot')">Forgot password?</button>
                  `}
                </div>
                <p class="small muted" style="text-align:center;margin-top:14px">
                  Demo accounts are stored in this browser only.
                </p>
              </form>
            </div>
          </div>`;
        return;
      }

      const nav = [
        ["Dashboard","▦"],["Simulation","⌘"],["Tutorials","▤"],
        ["AI Copilot","✧"],["Code Lab","‹›"],["Trivia","★"]
      ];
      let content = page === "Dashboard" ? renderDashboard()
        : page === "Simulation" ? renderSimulation()
        : page === "Tutorials" ? renderTutorials()
        : page === "AI Copilot" ? renderCopilot()
        : page === "Code Lab" ? renderCodeLab()
        : renderTrivia();

      root.innerHTML = `<header class="topbar">
        <div class="brand"><div class="brand-mark">ϟ</div><div>Chakra<span style="color:#f87171">Veda</span></div></div>
        <div class="rank"><div class="rank-line"><strong>Rank: Quantum Innovator · Level 4</strong><span id="xp-label">${xp}/600 XP</span></div><div class="progress"><div id="xp-bar" style="width:${Math.min(xp/6,100)}%"></div></div></div>
        <div style="display:flex;align-items:center;gap:8px">
          <span class="small muted" style="max-width:160px;overflow:hidden;text-overflow:ellipsis">${esc(user)}</span>
          <button class="button button-small" onclick="openChangePassword()">Change password</button>
          <button class="button button-small" onclick="logout()">Sign out</button>
        </div>
      </header>
      <div class="shell">
        <aside class="sidebar"><div class="side-label">WORKSPACE</div><nav class="nav-list">${nav.map(([name, icon]) => `<button class="nav-button ${page===name?"active":""}" onclick="navigate('${name}')"><span>${icon}</span>${name}</button>`).join("")}
        <div class="card small muted" style="margin-top:25px;line-height:1.6"><strong style="color:#f87171">Build with care</strong><br>Use datasheets and safe lab practices when moving from simulation to hardware.</div></nav></aside>
        <main><div class="content">${content}<footer>ChakraVeda · Smart ENTC Learning & Innovation Platform</footer></div></main>
      </div>
      ${moduleDrawer()}
      ${changePasswordModal()}`;

      if (page === "Trivia") startQuizTimer();
    }

    render();
  </script>
</body>
</html>
