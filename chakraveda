            `[${code.includes("pinMode") ? "PASS" : "FAIL"}] Pin initialization`
          ].join("\\n");
        }
        compiling = false;
        render();
      }, compile ? 1500 : 900);
    }

    function resetCode() {
      code = `const int sensorPin = A0;
const int fanPin = 13;
const float thresholdC = 75.0;

void setup() {
  pinMode(fanPin, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  int raw = analogRead(sensorPin);
  float voltage = raw * (5.0 / 1023.0);
  float temperatureC = (voltage - 0.5) * 100.0;

  if (temperatureC > thresholdC) {
    digitalWrite(fanPin, HIGH);
  } else {
    digitalWrite(fanPin, LOW);
  }
  delay(250);
}`;
      terminal = "Starter sketch restored.";
      render();
    }

