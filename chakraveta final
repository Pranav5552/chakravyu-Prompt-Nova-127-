 S.c.forEach(c=>PN(c.t).forEach((q,i)=>{const[x,y]=pinPos(c,i),k=c.id+'.'+i,a=Math.abs(q[0])>=Math.abs(q[1])?[Math.sign(q[0]),0]:[0,Math.sign(q[1])],o=rot(a[0],a[1],c.r);
  h+=`<circle data-pin="${k}" cx="${x}" cy="${y}" r="6" fill="${S.pend==k?'#ff1f3d':'#ff1f3d22'}" stroke="#ff1f3d" style="cursor:crosshair"/>`;
  if(q[2]&&c.t!='uno')h+=`<text x="${x+o[0]*13}" y="${y+o[1]*13+4}" style="fill:#ff9aa5;font-size:10px">${q[2]}</text>`;
  if(q[2]&&c.t=='uno')h+=`<text x="${x-22}" y="${y+4}" style="fill:#ff9aa5;font-size:10px">${q[2]}</text>`}));
 $('#cv').innerHTML=h;$('#tm').textContent='t = '+S.t.toFixed(3)+' s'}
function info(){const c=S.c.find(c=>c.id==S.sel);if(c)S.pr=c.id;$('#inf').innerHTML=c?`<b>${c.ref}</b> · ${SY[c.t].n}<br>${c.v!=null?`<label>Value (${SY[c.t].u})<input type="number" min="1" value="${c.v}" oninput="setV(${c.id},this.value)"></label>`:''}${c.t=='sw'?'Click the switch to open/close it.<br>':''}<small>The scope probes the selected part.</small><br><button onclick="rotSel()">↻ Rotate</button> <button onclick="delSel()">Delete</button>`:'<b>Tips</b><br>Click a part to select it and drag to move. Click one pin, then another, to wire (orthogonal, KiCad style). R rotates, Del deletes, double-click a wire to remove it.'}
const cv=$('#cv');let dr=null;
const pt=e=>{const p=cv.createSVGPoint();p.x=e.clientX;p.y=e.clientY;const q=p.matrixTransform(cv.getScreenCTM().inverse());return[q.x,q.y]};
cv.addEventListener('pointerdown',e=>{const pin=e.target.dataset.pin;
 if(pin){if(!S.pend)S.pend=pin;else{if(S.pend!=pin)S.w.push([S.pend,pin]);S.pend=null}render();return}
 const g=e.target.closest('[data-id]');
 if(g){const c=S.c.find(c=>c.id==g.dataset.id),[x,y]=pt(e);S.sel=c.id;dr={c,dx:x-c.x,dy:y-c.y,m:0};info();render()}
 else{S.sel=null;S.pend=null;info();render()}});
addEventListener('pointermove',e=>{if(!dr)return;const[x,y]=pt(e);dr.m=1;dr.c.x=Math.round((x-dr.dx)/20)*20;dr.c.y=Math.round((y-dr.dy)/20)*20;render()});
addEventListener('pointerup',()=>{if(dr&&!dr.m&&dr.c.t=='sw'){dr.c.on^=1;render()}dr=null});
cv.addEventListener('dblclick',e=>{const w=e.target.dataset.w,g=e.target.closest('[data-id]');if(w!=null)S.w.splice(+w,1);else if(g)del(+g.dataset.id);render()});
addEventListener('keydown',e=>{if(/INPUT|TEXTAREA/.test(e.target.tagName)||$('#sim').classList.contains('hide'))return;if(e.key=='r'||e.key=='R')rotSel();if(e.key=='Delete'||e.key=='Backspace')delSel();if(e.key=='Escape'){S.pend=null;render()}});
