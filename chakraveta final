const SYM={Resistor:'res',Capacitor:'cap',Inductor:'ind',Diode:'dio',LED:'led','Transistor (BJT)':'npn','Op-Amp':'opamp','Arduino Uno':'uno'};
function symSvg(n){const t=SYM[n];if(!t)return'';const s=SY[t],cc=s.c;return`<svg viewBox="-75 -50 150 100" width="150" height="100" style="float:right;background:#0b0b0b;border:1px solid #2c2c2c;border-radius:8px">${cc?`<circle cx="${cc[0]}" cy="${cc[1]}" r="${cc[2]}" ${SC}/>`:''}<path d="${s.d}" ${SC} transform="${t=='uno'?'scale(.7)':''}"/>${s.p.map(q=>{const k=t=='uno'?.7:1,x=q[0]*k,y=q[1]*k;return`<circle cx="${x}" cy="${y}" r="3" fill="#ff1f3d"/><text x="${x+(x<0?-10:10)*(Math.abs(x)>=Math.abs(y)?1:0.8)}" y="${y+(Math.abs(x)>=Math.abs(y)?4:(y<0?-6:12))}" style="fill:#ff9aa5;font-size:10px">${q[2]}</text>`}).join('')}</svg>`}
/* ---------- CODE (mini Arduino interpreter) ---------- */
let rid=0;
const out=s=>{const e=$('#ser');e.textContent=(e.textContent+s+'\n').slice(-1500);e.scrollTop=1e9};
function runCode(){stopAll();const src=$('#code').value;$('#ser').textContent='';
 const body=n=>{const i=src.search(new RegExp('void\\s+'+n+'\\s*\\(\\s*\\)\\s*\\{'));if(i<0)return'';let d=0,k=src.indexOf('{',i);const j=k;for(;k<src.length;k++){if(src[k]=='{')d++;if(src[k]=='}'&&!--d)break}return src.slice(j+1,k)};
 const tok=s=>[...s.matchAll(/digitalWrite\(\s*13\s*,\s*(HIGH|LOW)\s*\)|delay\(\s*(\d+)\s*\)|Serial\.print(?:ln)?\(\s*"([^"]*)"\s*\)/g)].map(m=>m[1]?['w',m[1]=='HIGH']:m[2]?['d',+m[2]]:['p',m[3]]);
 if(!/void\s+loop/.test(src)){out('Error: loop() not found');return}
 startSim();const id=++rid,sl=ms=>new Promise(r=>setTimeout(r,ms));
 (async()=>{const ex=async t=>{for(const[k,v]of t){if(id!=rid)return;if(k=='w'){S.d=v;render()}else if(k=='d')await sl(v);else out(v)}};
  await ex(tok(body('setup')));const L=tok(body('loop'));
  while(id==rid){await ex(L);await sl(L.some(t=>t[0]=='d')?0:30)}})()}
