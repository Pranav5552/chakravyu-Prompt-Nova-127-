const esc=s=>s.replace(/[&<>]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;'})[m]);
function analyze(){if(!S.c.length)return'Your canvas is empty. Add components or load an example.';const w=S.run;S.run=1;solve();S.run=w;const m=[];
 if(!S.c.some(c=>c.t=='bat'||c.t=='uno'))m.push('No power source (battery or Arduino).');
 S.c.forEach(c=>{PN(c.t).forEach((_,i)=>{if(!S.w.some(x=>x.includes(c.id+'.'+i)))m.push(`${TY[c.t].n} #${c.id}: pin ${i+1} is not connected.`)});
  if(c.t=='led'&&(c.burn||c.I>.03))m.push(`LED #${c.id} would burn out. Add a series resistor: R = (Vs − 2) / 0.015.`)});
 return m.length?m.join('<br>'):'No obvious problems found. Press Simulate to check voltages and currents.'}
function ans(q){
 if(/analy|my circuit|check/.test(q))return analyze();
 if(/resistor/.test(q)&&/led/.test(q))return'Use R = (Vs − Vf) / I. Example: (9 V − 2 V) / 15 mA ≈ 470 Ω (use the next standard value up).';
 if(/ohm/.test(q))return'Ohm’s law: V = I × R. Power: P = V × I. Example: 9 V across 330 Ω gives about 27 mA.';
 const t=T.find(t=>new RegExp('\\b'+t[0].toLowerCase().split(' ')[0]).test(q));
 if(t)return`<b>${t[0]}</b>: ${t[2]} Uses: ${t[4]}. Pros: ${t[5]}. Cons: ${t[6]}.`;
 return'Try asking about a component (resistor, diode, relay, ESP32…), “Ohm’s law”, or press Analyze my circuit.'}
